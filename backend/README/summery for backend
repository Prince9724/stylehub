  "success": true,
  "message": "Razorpay order created successfully",
  "data": {
    "razorpayOrderId": "order_xxxxxxxxxxxx",
    "amount": 104800,
    "currency": "INR",
    "orderId": "67a8b2c3d4e5f6a7b8c9d999"
  }
}
